<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="2.5dp"
            android:layout_height="17dp"
            android:background="#C23B2E" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:text="订 阅"
            android:textColor="#1A1410"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:fontFamily="sans-serif-light"
            android:text="收藏"
            android:textColor="#8B6914"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:fontFamily="sans-serif-light"
            android:text="订阅源"
            android:textColor="#8B6914"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 搜索框：云灰 1px 底线，聚焦浮起 -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#B8AC94"
        android:fontFamily="sans-serif-light"
        android:hint="搜订阅源名，或 group:分组"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingTop="6dp"
        android:paddingBottom="9dp"
        android:textColor="#1A1410"
        android:textColorHint="#B8AC94"
        android:textSize="13sp" />

    <io.legado.app.ui.widget.recycler.RecyclerViewAtPager2
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <TextView
        android:id="@+id/tv_empty_msg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="还没有订阅源。点右上「订阅源」导入一个。"
        android:textColor="#9B9687"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
