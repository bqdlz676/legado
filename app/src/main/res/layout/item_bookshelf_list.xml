<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_ink_book_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="86dp"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp"
    android:scrollbars="none">

    <!-- 竖排书名：书名就是封面 -->
    <TextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:maxLines="4"
        android:scrollbars="none"
        android:textColor="#1A1410"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="春\n秋\n左\n传" />

    <!-- 书名右侧一道朱砂竖线，长度 = 阅读进度 -->
    <io.legado.app.ui.widget.InkProgressLineView
        android:id="@+id/ink_progress_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintLeft_toRightOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name" />

    <FrameLayout
        android:id="@+id/fl_has_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <io.legado.app.ui.widget.text.BadgeView
            android:id="@+id/bv_unread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:includeFontPadding="false"
            android:scrollbars="none" />

    <!-- 右缘竖排淡墨水印：阅读进度 -->
    <TextView
        android:id="@+id/tv_watermark"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:alpha="0.09"
        android:fontFamily="serif"
        android:gravity="center_vertical|end"
        android:includeFontPadding="false"
        android:lineSpacingExtra="-6dp"
        android:textColor="#1A1410"
        android:textSize="19sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="4\n5\n%" />

    <io.legado.app.ui.widget.anima.RotateLoading
            android:id="@+id/rl_loading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- 作者：一行云灰小字 -->
    <TextView
        android:id="@+id/tv_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#6E6250"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        android:layout_marginStart="9dp"
        app:layout_constraintRight_toLeftOf="@+id/tv_watermark"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="杜预 注" />

    <!-- 读到哪一章 -->
    <TextView
        android:id="@+id/tv_read"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#3D3426"
        android:textSize="12sp"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        android:layout_marginStart="9dp"
        app:layout_constraintRight_toLeftOf="@+id/tv_watermark"
        app:layout_constraintTop_toBottomOf="@+id/tv_author"
        tools:text="隐公元年" />

    <!-- 最新一章 -->
    <TextView
        android:id="@+id/tv_last"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#8C8272"
        android:textSize="11sp"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        android:layout_marginStart="9dp"
        app:layout_constraintRight_toLeftOf="@+id/tv_watermark"
        app:layout_constraintTop_toBottomOf="@+id/tv_read"
        tools:text="共 12 章" />

    <TextView
        android:id="@+id/tv_last_update_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#A2967F"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_author"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="3 天前" />

    <TextView
        android:id="@+id/tv_read_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="#C23B2E"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/pb_read_progress"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="60%" />

    <!-- 底部细线进度：朱砂已读 / 云灰未读 -->
    <io.legado.app.ui.widget.InkThinProgress
        android:id="@+id/pb_read_progress"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- 封面：默认不显示，书名就是封面 -->
    <io.legado.app.ui.widget.image.CoverImageView
        android:id="@+id/iv_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/img_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/image_cover_default"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 图标保留 id，不再显示 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_author"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/author"
        android:src="@drawable/ic_author"
        android:visibility="gone"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_read"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/read_dur_progress"
        android:src="@drawable/ic_history"
        android:visibility="gone"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_last"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/lasted_show"
        android:src="@drawable/ic_book_last"
        android:visibility="gone"
        app:layout_constraintLeft_toRightOf="@+id/ink_progress_line"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/vw_foreground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
