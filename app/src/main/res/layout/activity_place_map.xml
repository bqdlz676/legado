<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF6EA">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="这个地名还没收录坐标。"
        android:textColor="#8A7A5E"
        android:textSize="15sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_ink_round_btn"
        android:contentDescription="返回"
        android:src="@drawable/ic_arrow_back"
        android:tint="#1A1410" />

    <TextView
        android:id="@+id/btn_battle"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_ink_chip"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center"
        android:text="推演"
        android:textColor="#C23B2E"
        android:textSize="13sp" />

</FrameLayout>
