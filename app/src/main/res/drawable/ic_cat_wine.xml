<?xml version="1.0" encoding="utf-8"?>
<!-- 名酒类别图标：小酒壶——圆肚 + 窄颈 + 口部小弧，仅描边无填充 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- 底部圆肚：x=7→17 y=12→20，颈口(10,12)/(14,12) 相接 -->
  <path
      android:pathData="M10,12 C7,14 7,17.5 12,20 C17,17.5 17,14 14,12"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 上部窄颈：左竖线 x=10 y=7→12 -->
  <path
      android:pathData="M10,7 L10,12"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 上部窄颈：右竖线 x=14 y=7→12 -->
  <path
      android:pathData="M14,7 L14,12"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 口部小弧：x=9→15 y=5 -->
  <path
      android:pathData="M9,5 Q12,6.2 15,5"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
</vector>
