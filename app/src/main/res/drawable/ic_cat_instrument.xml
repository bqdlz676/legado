      android:pathData="M5,14 Q12,12.5 19,14"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 上弦：x=8→16 y=12 -->
  <path
      android:pathData="M8,12 L16,12"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 下弦：x=8→16 y=16 -->
  <path
      android:pathData="M8,16 L16,16"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
