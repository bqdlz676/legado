<?xml version="1.0" encoding="utf-8"?>
<!-- 批注图标：卷轴意象——中央竖轴连接上下两道空心轴杆（卷轴），仅描边无填充 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- 竖线（轴）x=12 y=4→20 -->
  <path
      android:pathData="M12,4 L12,20"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 上端横条 x=8→16 y=3，高 2dp：闭合小矩形描边 y=3→5（空心轴杆，非单根横线） -->
  <path
      android:pathData="M8,3 L16,3 L16,5 L8,5 Z"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 下端横条 x=8→16 y=20，高 2dp：闭合小矩形描边 y=20→22（空心轴杆，非单根横线） -->
  <path
      android:pathData="M8,20 L16,20 L16,22 L8,22 Z"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
</vector>
