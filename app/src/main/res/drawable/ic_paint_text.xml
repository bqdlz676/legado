<?xml version="1.0" encoding="utf-8"?>
<!-- 画板工具栏 · 文字：细线圆角方框 (6,8)→(18,8)→(18,18)→(6,18) 闭合；框内极小"文"（点+撇+捺简笔，path 直绘，全程描边、无填充色） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- 圆角方框：x=6 y=8→18→18→6 闭合，圆角 r=2 -->
  <path
      android:strokeColor="#8B6914"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M8,8 H16 Q18,8 18,10 V16 Q18,18 16,18 H8 Q6,18 6,16 V10 Q6,8 8,8 Z" />
  <!-- 文·点：顶部短竖画，round cap 收为点形（描边，不用填充色） -->
  <path
      android:strokeColor="#8B6914"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M12,9.4 L12,10.5" />
  <!-- 文·撇：中心向左下 -->
  <path
      android:strokeColor="#8B6914"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M12,11.4 L9.8,16" />
  <!-- 文·捺：中心向右下 -->
  <path
      android:strokeColor="#8B6914"
      android:strokeWidth="1.5"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:pathData="M12,11.4 L14.2,16" />
</vector>
