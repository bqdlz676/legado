<?xml version="1.0" encoding="utf-8"?>
<!-- 名剑类别图标：竖线剑身 + 上端护手横线 + 下端尖三角，仅描边无填充 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- 竖线（剑身）x=12 y=4→17 -->
  <path
      android:pathData="M12,4 L12,17"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 上端横线（护手）x=8→16 y=4 -->
  <path
      android:pathData="M8,4 L16,4"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 下端尖三角 M8,17 L12,22 L16,17 -->
  <path
      android:pathData="M8,17 L12,22 L16,17"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
</vector>
