  <path
      android:pathData="M9,7 A3,3 0 1 1 15,7 A3,3 0 1 1 9,7"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 竖线（身）x=12 y=10→17 -->
  <path
      android:pathData="M12,10 L12,17"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
  <!-- 横线（臂）x=8→16 y=13 -->
  <path
      android:pathData="M8,13 L16,13"
      android:strokeWidth="1.5"
      android:strokeColor="#8B6914"
      android:strokeLineCap="round"
      android:strokeLineJoin="round" />
</vector>
