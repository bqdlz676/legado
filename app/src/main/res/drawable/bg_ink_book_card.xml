<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 纸面 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F6F0E3" />
            <corners android:radius="6dp" />
            <stroke
                android:width="1dp"
                android:color="#33D4A54A" />
        </shape>
    </item>
    <!-- 左上暖烛光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.12"
                android:centerY="0.06"
                android:gradientRadius="360dp"
                android:startColor="#1FFFE7BE"
                android:endColor="#00FFE7BE" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- 底部暖金微光溢出 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00D4A54A"
                android:centerColor="#0AD4A54A"
                android:endColor="#26D4A54A" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
