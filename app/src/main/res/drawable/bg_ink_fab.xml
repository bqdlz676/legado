<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#33C23B2E" />
            <stroke
                android:width="1dp"
                android:color="#8B6914" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#0D1A1410" />
            <stroke
                android:width="1dp"
                android:color="#4D8B6914" />
        </shape>
    </item>
</selector>
